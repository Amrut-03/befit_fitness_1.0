rules_version = '2';

// BeFit Firestore security rules.
//
// Every document the app reads or writes lives under users/{uid}:
//   users/{uid}                     profile, onboarding, streak fields
//   users/{uid}/foodItems/{id}
//   users/{uid}/dietPlans/{id}
//   users/{uid}/dietHistory/{id}
//   users/{uid}/workoutHistory/{id}
//   users/{uid}/health_metrics/{id}
//
// A signed-in user (Google or anonymous guest) can only access their own
// tree. Everything else is denied by default.
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read, write: if isOwner(uid);

      match /{document=**} {
        allow read, write: if isOwner(uid);
      }
    }
  }
}
